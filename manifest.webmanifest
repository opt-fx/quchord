{
  "id": "/quchord/",
  "name": "QuChord",
  "short_name": "QuChord",
  "description": "Chord generator, arpeggiator and Euclidean sequencer for any MIDI keyboard. Unofficial community tool by OPT.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "related_applications": [{ "platform": "webapp", "url": "https://opt-fx.com/quchord/manifest.webmanifest" }],
  "background_color": "#111214",
  "theme_color": "#111214",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
